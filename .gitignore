# ── Go ────────────────────────────────────────────────────────────────────────
backend/vendor/
backend/*.test
backend/*.out
backend/coverage.txt
# compiled binaries
backend/server
backend/cmd/*/server
backend/cmd/*/*.bin

# ── Python (backend-py) ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
.python-version
pip-wheel-metadata/
*.egg-info/
*.egg
.eggs/
# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
# mypy / pyright
.mypy_cache/
.dmypy.json
.pyright/
# generated protobuf stubs (regenerated by `make gen-python`)
backend-py/src/authspa/generated/
refer_code/

# ── Node / frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/.vite/
frontend/coverage/
*.tsbuildinfo

# ── Playwright ────────────────────────────────────────────────────────────────
.playwright-mcp/
.playwright-cli/
playwright-report/
test-results/

# ── Build artifacts ───────────────────────────────────────────────────────────
dist/
*.o
*.a
*.so

# ── Docker ────────────────────────────────────────────────────────────────────
.dockerignore.local

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.swn
*~

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

